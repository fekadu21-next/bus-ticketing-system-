{
  "expo": {
    "name": "TicketVerifier",
    "slug": "ticket-verifier",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ticketverifier",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0f766e"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
