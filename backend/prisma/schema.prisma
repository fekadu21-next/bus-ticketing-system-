generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model roles {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @unique @db.VarChar(50)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model permissions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @unique @db.VarChar(100)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_permission")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_role")

  @@id([role_id, permission_id])
  @@index([role_id])
  @@index([permission_id])
}

model organizations {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String       @db.VarChar(150)
  type       String?      @db.VarChar(50)
  status     String       @default("PENDING") @db.VarChar(30)
  is_active  Boolean      @default(true)
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime     @default(now()) @db.Timestamptz(6)
  user_roles user_roles[]
  buses      buses[]
  routes     routes[]
  trips      trips[]
  bookings             bookings[]
  payments             payments[]
  tickets              tickets[]
  ticket_verifications ticket_verifications[]
  feedbacks            feedbacks[]
  trip_problem_reports trip_problem_reports[]

  @@index([status])
  @@index([type])
}

model user_roles {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String         @db.Uuid
  role_id         String         @db.Uuid
  organization_id String?        @db.Uuid
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_organization")
  roles           roles          @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_role")
  users           users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_user")

  @@index([user_id])
  @@index([role_id])
  @@index([organization_id])
}

model users {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name                String                      @db.VarChar(100)
  last_name                 String                      @db.VarChar(100)
  email                     String                      @unique @db.VarChar(255)
  phone                     String?                     @unique @db.VarChar(30)
  password_hash             String
  avatar_url                String?
  is_active                 Boolean                     @default(true)
  email_verified            Boolean                     @default(false)
  email_verified_at         DateTime?                   @db.Timestamptz(6)
  failed_login_attempts     Int                         @default(0)
  locked_until              DateTime?                   @db.Timestamptz(6)
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  last_login_at             DateTime?                   @db.Timestamptz(6)
  audit_logs                audit_logs[]
  email_verification_tokens email_verification_tokens[]
  password_reset_tokens     password_reset_tokens[]
  refresh_tokens            refresh_tokens[]
  user_roles                user_roles[]
  bookings                  bookings[]
  tickets                   tickets[]               @relation("PassengerTickets")
  verified_tickets          tickets[]               @relation("VerifiedTickets")
  ticket_verifications      ticket_verifications[]  @relation("VerifierVerifications")
  feedbacks                 feedbacks[]             @relation("PassengerFeedbacks")
  driven_trips              trips[]                 @relation("DriverTrips")
  driver_problems           trip_problem_reports[]  @relation("DriverProblems")
  resolved_problems         trip_problem_reports[]  @relation("ResolvedProblems")
}

model refresh_tokens {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String    @db.Uuid
  token_hash           String    @unique @db.VarChar(255)
  expires_at           DateTime  @db.Timestamptz(6)
  revoked_at           DateTime? @db.Timestamptz(6)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  replaced_by_token_id String?   @db.Uuid
  user_agent           String?
  ip_address           String?   @db.VarChar(45)
  users                users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@index([token_hash])
}

model password_reset_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@index([token_hash])
}

model email_verification_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@index([token_hash])
}

model audit_logs {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?  @db.Uuid
  action     String   @db.VarChar(100)
  details    Json?
  ip_address String?  @db.VarChar(45)
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
}

model buses {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  plate_number    String        @db.VarChar(50)
  model           String?       @db.VarChar(100)
  capacity        Int           @default(50)
  is_active       Boolean       @default(true)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  trips           trips[]

  @@unique([organization_id, plate_number], name: "uq_bus_org_plate")
  @@index([organization_id])
}

model routes {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id          String        @db.Uuid
  origin                   String        @db.VarChar(100)
  destination              String        @db.VarChar(100)
  distance_km              Float?
  estimated_duration_hours Float?
  is_active                Boolean       @default(true)
  created_at               DateTime      @default(now()) @db.Timestamptz(6)
  updated_at               DateTime      @default(now()) @db.Timestamptz(6)
  organizations            organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  trips                    trips[]

  @@index([organization_id])
}

model trips {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  bus_id          String        @db.Uuid
  route_id        String        @db.Uuid
  departure_time  DateTime      @db.Timestamptz(6)
  arrival_time    DateTime?     @db.Timestamptz(6)
  fare            Decimal       @db.Decimal(10, 2)
  status          String        @default("SCHEDULED") @db.VarChar(30)
  driver_id       String?       @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  buses           buses         @relation(fields: [bus_id], references: [id], onDelete: Restrict)
  routes          routes        @relation(fields: [route_id], references: [id], onDelete: Restrict)
  driver          users?        @relation("DriverTrips", fields: [driver_id], references: [id], onDelete: SetNull)
  seats           seats[]
  bookings        bookings[]
  tickets         tickets[]
  ticket_verifications ticket_verifications[]
  feedbacks       feedbacks[]
  trip_problem_reports trip_problem_reports[]

  @@index([organization_id])
  @@index([bus_id])
  @@index([route_id])
  @@index([driver_id])
  @@index([departure_time])
  @@index([status])
}

model seats {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id     String     @db.Uuid
  seat_number Int
  status      String     @default("AVAILABLE") @db.VarChar(30)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  trips       trips      @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  bookings    bookings[]
  tickets     tickets[]

  @@unique([trip_id, seat_number], name: "uq_trip_seat_number")
  @@index([trip_id])
  @@index([status])
}

model bookings {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  trip_id         String        @db.Uuid
  passenger_id    String        @db.Uuid
  seat_id         String?       @db.Uuid
  seat_number     Int
  total_fare      Decimal       @db.Decimal(10, 2)
  status          String        @default("CONFIRMED") @db.VarChar(30)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  trips           trips         @relation(fields: [trip_id], references: [id], onDelete: Restrict)
  users           users         @relation(fields: [passenger_id], references: [id], onDelete: Restrict)
  seats           seats?        @relation(fields: [seat_id], references: [id], onDelete: SetNull)
  payments        payments?
  tickets         tickets?
  feedbacks       feedbacks[]

  @@index([organization_id])
  @@index([trip_id])
  @@index([passenger_id])
  @@index([status])
}

model payments {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id            String        @unique @db.Uuid
  organization_id       String        @db.Uuid
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("ETB") @db.VarChar(10)
  payment_method        String        @db.VarChar(50)
  transaction_reference String?       @unique @db.VarChar(100)
  status                String        @default("COMPLETED") @db.VarChar(30)
  created_at            DateTime      @default(now()) @db.Timestamptz(6)
  updated_at            DateTime      @default(now()) @db.Timestamptz(6)
  bookings              bookings      @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  organizations         organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([status])
}

model tickets {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_number        String                 @unique @db.VarChar(50)
  booking_id           String                 @unique @db.Uuid
  passenger_id         String                 @db.Uuid
  trip_id              String                 @db.Uuid
  seat_id              String?                @db.Uuid
  seat_number          Int
  organization_id      String                 @db.Uuid
  status               String                 @default("UNUSED") @db.VarChar(30)
  qr_token             String                 @unique @db.Text
  verified_at          DateTime?              @db.Timestamptz(6)
  verified_by          String?                @db.Uuid
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  bookings             bookings               @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  passenger            users                  @relation("PassengerTickets", fields: [passenger_id], references: [id], onDelete: Restrict)
  verifier             users?                 @relation("VerifiedTickets", fields: [verified_by], references: [id], onDelete: SetNull)
  trips                trips                  @relation(fields: [trip_id], references: [id], onDelete: Restrict)
  seats                seats?                 @relation(fields: [seat_id], references: [id], onDelete: SetNull)
  organizations        organizations          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  ticket_verifications ticket_verifications[]

  @@index([organization_id])
  @@index([trip_id])
  @@index([passenger_id])
  @@index([status])
  @@index([ticket_number])
  @@index([qr_token])
}

model ticket_verifications {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id       String?       @db.Uuid
  booking_id      String?       @db.Uuid
  trip_id         String?       @db.Uuid
  verifier_id     String        @db.Uuid
  organization_id String        @db.Uuid
  result          String        @db.VarChar(30)
  notes           String?       @db.Text
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  tickets         tickets?      @relation(fields: [ticket_id], references: [id], onDelete: SetNull)
  trips           trips?        @relation(fields: [trip_id], references: [id], onDelete: SetNull)
  verifier        users         @relation("VerifierVerifications", fields: [verifier_id], references: [id], onDelete: Restrict)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@index([verifier_id])
  @@index([trip_id])
  @@index([organization_id])
  @@index([result])
  @@index([created_at])
}

model feedbacks {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id         String         @db.Uuid
  passenger_id    String         @db.Uuid
  booking_id      String?        @db.Uuid
  organization_id String?        @db.Uuid
  rating          Int            @db.SmallInt
  comment         String?        @db.Text
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @default(now()) @db.Timestamptz(6)
  trips           trips          @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  passenger       users          @relation("PassengerFeedbacks", fields: [passenger_id], references: [id], onDelete: Restrict)
  bookings        bookings?      @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([trip_id, passenger_id], name: "uq_trip_passenger_feedback")
  @@index([trip_id])
  @@index([passenger_id])
  @@index([organization_id])
}

model trip_problem_reports {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id         String        @db.Uuid
  driver_id       String        @db.Uuid
  organization_id String        @db.Uuid
  type            String        @db.VarChar(50)
  description     String        @db.Text
  status          String        @default("PENDING") @db.VarChar(30)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  resolved_at     DateTime?     @db.Timestamptz(6)
  resolved_by     String?       @db.Uuid

  trips           trips         @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  driver          users         @relation("DriverProblems", fields: [driver_id], references: [id], onDelete: Restrict)
  resolver        users?        @relation("ResolvedProblems", fields: [resolved_by], references: [id], onDelete: SetNull)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([trip_id])
  @@index([driver_id])
  @@index([organization_id])
  @@index([status])
  @@index([created_at])
}
