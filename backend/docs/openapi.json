{
  "openapi": "3.0.3",
  "info": {
    "title": "Bus Ticketing Platform API - Passenger & Ticket Verifier",
    "version": "1.0.0",
    "description": "Production-grade RESTful API endpoints for PASSENGER and TICKET_VERIFIER roles in the Intercity Bus Ticketing Platform."
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "statusCode": { "type": "integer", "example": 400 },
          "message": { "type": "string", "example": "Validation error" },
          "errors": { "type": "array", "items": { "type": "string" } }
        }
      },
      "VerificationResult": {
        "type": "object",
        "properties": {
          "valid": { "type": "boolean", "example": true },
          "status": {
            "type": "string",
            "enum": ["VALID", "ALREADY_USED", "INVALID", "CANCELLED", "WRONG_TRIP"],
            "example": "VALID"
          },
          "message": { "type": "string", "example": "Ticket verified successfully. Passenger may board." },
          "ticket": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "ticketNumber": { "type": "string", "example": "TKT-M1A2B3-4567" },
              "seat": { "type": "string", "example": "A5" },
              "seatNumber": { "type": "integer", "example": 5 },
              "tripId": { "type": "string", "format": "uuid" },
              "passenger": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "format": "uuid" },
                  "name": { "type": "string", "example": "Abebe Bikila" },
                  "email": { "type": "string", "example": "abebe@example.com" }
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/passenger/trips": {
      "get": {
        "tags": ["Passenger"],
        "summary": "Search trips",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "origin", "in": "query", "schema": { "type": "string" } },
          { "name": "destination", "in": "query", "schema": { "type": "string" } },
          { "name": "date", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "operator", "in": "query", "schema": { "type": "string" } },
          { "name": "operatorId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "enum": ["departureTime", "fare"] } },
          { "name": "sortOrder", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"] } }
        ],
        "responses": {
          "200": { "description": "List of available trips" }
        }
      }
    },
    "/passenger/trips/{tripId}": {
      "get": {
        "tags": ["Passenger"],
        "summary": "Get trip details",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "tripId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Trip details and seat status inventory" },
          "404": { "description": "Trip not found" }
        }
      }
    },
    "/passenger/trips/{tripId}/seats": {
      "get": {
        "tags": ["Passenger"],
        "summary": "Get seat availability for trip",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "tripId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Real-time seat availability map" }
        }
      }
    },
    "/passenger/bookings": {
      "post": {
        "tags": ["Passenger"],
        "summary": "Create booking (seat reservation)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tripId"],
                "properties": {
                  "tripId": { "type": "string", "format": "uuid" },
                  "seatNumber": { "type": "integer", "example": 5 },
                  "seatId": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Booking reserved successfully" },
          "409": { "description": "Seat is no longer available" }
        }
      },
      "get": {
        "tags": ["Passenger"],
        "summary": "View own bookings",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of personal bookings" }
        }
      }
    },
    "/passenger/bookings/{id}": {
      "get": {
        "tags": ["Passenger"],
        "summary": "View booking details",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Booking details" },
          "404": { "description": "Booking not found or not owned by passenger" }
        }
      }
    },
    "/passenger/payments/initialize": {
      "post": {
        "tags": ["Passenger"],
        "summary": "Initialize payment transaction",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["bookingId"],
                "properties": {
                  "bookingId": { "type": "string", "format": "uuid" },
                  "paymentMethod": { "type": "string", "enum": ["TELEBIRR", "CHAPA", "CBE_BIRR"], "default": "TELEBIRR" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Payment checkout session initialized" }
        }
      }
    },
    "/passenger/payments/verify": {
      "post": {
        "tags": ["Passenger"],
        "summary": "Verify payment and issue digital ticket",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bookingId": { "type": "string", "format": "uuid" },
                  "transactionReference": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Payment confirmed and digital ticket issued" }
        }
      }
    },
    "/passenger/tickets": {
      "get": {
        "tags": ["Passenger"],
        "summary": "List passenger digital tickets",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of confirmed digital tickets" }
        }
      }
    },
    "/passenger/tickets/{id}": {
      "get": {
        "tags": ["Passenger"],
        "summary": "View digital ticket and QR data",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Digital ticket details with signed QR token" },
          "404": { "description": "Ticket not found or not owned by passenger" }
        }
      }
    },
    "/passenger/feedback": {
      "post": {
        "tags": ["Passenger"],
        "summary": "Submit completed trip feedback",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tripId", "rating"],
                "properties": {
                  "tripId": { "type": "string", "format": "uuid" },
                  "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "comment": { "type": "string", "maxLength": 1000 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Feedback submitted successfully" },
          "400": { "description": "Trip has not departed or completed yet" },
          "403": { "description": "Passenger did not complete booking for this trip" },
          "409": { "description": "Duplicate feedback already submitted" }
        }
      }
    },
    "/verifier/trips": {
      "get": {
        "tags": ["Ticket Verifier"],
        "summary": "List assigned trips for verifier operator",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Trips assigned to verifier organization with verification summaries" },
          "403": { "description": "Forbidden for non-verifier users" }
        }
      }
    },
    "/verifier/trips/{tripId}": {
      "get": {
        "tags": ["Ticket Verifier"],
        "summary": "View trip boarding passenger manifest",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "tripId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Passenger manifest with ticket and seat numbers" },
          "403": { "description": "Trip belongs to a different operator" }
        }
      }
    },
    "/verifier/tickets/verify": {
      "post": {
        "tags": ["Ticket Verifier"],
        "summary": "Atomically verify boarding pass QR code",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["qrToken", "tripId"],
                "properties": {
                  "qrToken": { "type": "string" },
                  "tripId": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification result: VALID, ALREADY_USED, INVALID, CANCELLED, WRONG_TRIP",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VerificationResult" }
              }
            }
          },
          "403": { "description": "Trip or verifier belongs to another organization" }
        }
      }
    },
    "/verifier/history": {
      "get": {
        "tags": ["Ticket Verifier"],
        "summary": "View recent scan verification audit records",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Audit trail of verification attempts" }
        }
      }
    }
  }
}
