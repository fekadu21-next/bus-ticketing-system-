PORT=5000
NODE_ENV=development

# PostgreSQL connection strings
DATABASE_URL="postgresql://postgres:password@localhost:5432/busticket_db?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/busticket_db?schema=public"

# JWT Secret Keys (minimum 32 random characters in production)
JWT_ACCESS_SECRET="busticket_access_secret_production_key_32bytes_minimum"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="busticket_refresh_secret_production_key_32bytes_minimum"
JWT_REFRESH_EXPIRES_IN="7d"

# Client Web Application URL (for CORS and email callback links)
FRONTEND_URL="http://localhost:5173"

# Email Configuration (SMTP)
EMAIL_HOST="smtp.ethereal.email"
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="noreply@busticket.com"